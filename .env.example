# LLM backend - Ollama lokal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Set ke "true" kalau Ollama tidak tersedia (dev/testing tanpa Ollama running)
USE_MOCK_LLM=false

# Embedding: "tfidf" (ringan, default) atau "sentence-transformers" (butuh install tambahan)
EMBEDDING_BACKEND=tfidf
