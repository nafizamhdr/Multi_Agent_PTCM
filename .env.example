# LLM backend: Ollama (lokal, gratis, tanpa rate limit)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Embedding: "tfidf" (default, ringan & offline) atau "sentence-transformers"
# (kualitas semantik lebih baik, butuh internet saat pertama kali dijalankan
# untuk download model; otomatis fallback ke tfidf kalau gagal dimuat)
EMBEDDING_BACKEND=tfidf
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
